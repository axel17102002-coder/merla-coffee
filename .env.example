# Credenciales — copiá este archivo como .env y completá con tus valores reales
# (el .env está en .gitignore: NUNCA se sube a GitHub)

# Supabase → Connect / Settings → API
# Usá la Project URL, con formato https://TU-PROYECTO.supabase.co
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Secret key (sb_secret_...). Solo para funciones de Netlify; nunca en app.js.
SUPABASE_SECRET_KEY=TU-SECRET-KEY
# Alternativa para proyectos antiguos (no completes ambas):
# SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY

# Clave privada para entrar a /admin.html y gestionar pedidos por WhatsApp.
# Generá una larga y aleatoria; nunca la pongas en código ni la compartas.
ADMIN_TOKEN=REEMPLAZAR-POR-UNA-CLAVE-LARGA-Y-ALEATORIA

# MODO (opcional: sin esto usa las credenciales de test)
# MODO_ENV=produccion
# MODO_USERNAME=...
# MODO_PASSWORD=...
# MODO_PROCESSOR_CODE=...
# MODO_CC_CODE=1CSI

# Access Token de Mercado Pago (panel de desarrolladores → tu app → Credenciales)
# TEST-... = sandbox (no cobra), APP_USR-... = producción
MP_ACCESS_TOKEN=
